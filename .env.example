# Django Microservices Auth SDK Configuration
# Copy this file to .env and adjust the values for your environment

# Redis Configuration (optional - if not set, caching will be disabled)
AUTH_SDK_REDIS_HOST=localhost
AUTH_SDK_REDIS_PORT=6379
AUTH_SDK_REDIS_DB=0
# AUTH_SDK_REDIS_PASSWORD=your_redis_password
# AUTH_SDK_REDIS_SSL=false

# Cache Configuration
AUTH_SDK_CACHE_EXPIRATION=3600  # Cache expiration in seconds (1 hour)
AUTH_SDK_CACHE_PREFIX=auth_sdk
AUTH_SDK_ENABLE_CACHING=true

# Authentication Service Configuration
AUTH_SDK_SERVICE_HOST=localhost:8000
AUTH_SDK_SERVICE_SCHEME=http
AUTH_SDK_SERVICE_ENDPOINT=/api/user/get_details/
AUTH_SDK_SERVICE_TIMEOUT=10  # Request timeout in seconds

# JWT Configuration
AUTH_SDK_JWT_HEADER_PREFIX=JWT

# Features Configuration
AUTH_SDK_ENABLE_USER_DETAILS=true

# Logging Configuration
AUTH_SDK_LOG_LEVEL=INFO